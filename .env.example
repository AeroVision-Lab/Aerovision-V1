# AeroVision AI Service 配置

# ============ 基础配置 ============
APP_NAME=AeroVision-V1
APP_VERSION=0.1.0
DEBUG=false

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============ 日志配置 ============
LOG_LEVEL=INFO

# ============ 模型配置 ============
# 模型文件目录（相对路径或绝对路径）
MODEL_DIR=models

# 推理设备: cuda:0, cuda:1, cpu
DEVICE=cuda:0

# ============ 模型文件名 ============
# 机型分类器
AIRCRAFT_CLASSIFIER_MODEL=aircraft_classifier.pt
# 航司分类器
AIRLINE_CLASSIFIER_MODEL=airline_classifier.pt
# 注册号检测器
REGISTRATION_DETECTOR_MODEL=registration_detector.pt

# ============ 审核阈值 ============
# 图片质量通过阈值 (0-1)
QUALITY_THRESHOLD=0.70
# 注册号清晰度阈值 (0-1)
REGISTRATION_CLARITY_THRESHOLD=0.80
# 遮挡比例上限 (0-1)
OCCLUSION_THRESHOLD=0.20
# 分类器置信度阈值 (0-1)
CLASSIFIER_CONFIDENCE_THRESHOLD=0.50

# ============ 检测器参数 ============
DETECTOR_CONF=0.25
DETECTOR_IOU=0.45

# ============ OCR 配置 ============
OCR_LANG=en
OCR_MIN_CONFIDENCE=0.5

# ============ 请求限制 ============
# 最大图片大小 (字节)
MAX_IMAGE_SIZE=10485760
# 请求超时时间 (秒)
REQUEST_TIMEOUT=60

# ============ CORS ============
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# ============ 外部服务 ============
# 后端回调地址
BACKEND_CALLBACK_URL=
